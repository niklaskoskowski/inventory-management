# ============================================================
# Inventory Management - Apache protection / routing
# ============================================================

Options -Indexes
Options -MultiViews

RewriteEngine On


# ============================================================
# SECURITY: Never expose runtime/user data
# ============================================================

<IfModule mod_authz_core.c>
    <FilesMatch "^(data\.json|data\.json\.bak|checkout\.json|users\.json|\.trax\.lock|\.trax-update\.json|\.trax-update\.lock|config\.local\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    <FilesMatch "^(data\.json|data\.json\.bak|checkout\.json|users\.json|\.trax\.lock|\.trax-update\.json|\.trax-update\.lock|config\.local\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>


# ============================================================
# SECURITY: Keep the whole instance out of search engines
# One switch for every response from this directory, including the
# static files PHP never touches (scandebug.html, vendor/, images).
# ============================================================

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>


# ============================================================
# SECURITY: Block internal application directories
# PHP require/include still works - this only blocks HTTP access
# ============================================================

RewriteRule ^lib(?:/|$) - [F,L,NC]

# Documents should only be served through the application's
# authenticated download endpoint.
RewriteRule ^documents(?:/|$) - [F,L,NC]


# ============================================================
# SECURITY: Block repository/config files
# ============================================================

RewriteRule ^\.git(?:/|$) - [F,L,NC]
RewriteRule ^\.svn(?:/|$) - [F,L,NC]

<FilesMatch "^(\.env|\.gitignore|composer\.lock)$">
    Require all denied
</FilesMatch>


# ============================================================
# CLEAN URLS
# ============================================================

# /admin -> /admin.php
RewriteRule ^admin/?$ admin.php [L,QSA]

# Optional other clean URLs
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^booking/?$ booking.php [L,QSA]
RewriteRule ^view/?$ view.php [L,QSA]

# Short label URLs: /12 -> the asset, /12.1 -> unit 1 of it.
# This is what every printed QR encodes when TRAX_LABEL_URL_FORM is 'short'.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(\d+)(?:\.(\d+))?/?$ index.php?id=$1&u=$2 [L,QSA]


# ============================================================
# Default document
# ============================================================

DirectoryIndex index.php
